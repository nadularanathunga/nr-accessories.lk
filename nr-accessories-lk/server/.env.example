# Copy this file to .env and fill in your own values.
# MongoDB Atlas connection string (create a free cluster at https://www.mongodb.com/cloud/atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartgear?retryWrites=true&w=majority

# Any random long string, used to sign JWT login tokens
JWT_SECRET=change_this_to_a_long_random_secret

# Port the backend server will run on
PORT=5000
